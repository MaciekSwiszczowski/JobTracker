<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Every version here was the latest at the time the package was added. Take the latest when you add one -
    `dotnet add package <name>` resolves and records it - rather than copying a number out of another repository.
  -->
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Referenced only under the Debug_Analyzers configuration - see Directory.Build.props. Debug must stay fast, so
    it runs no analyzers at all.
  -->
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <!--
      ErrorProne.NET has shipped nothing but prereleases since 0.1.2 (2018), so "latest" here is a beta by
      necessity rather than by choice.
    -->
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="IDisposableAnalyzers" Version="4.0.8" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!--
      The VSTest adapter and host. `dotnet test` runs through Microsoft.Testing.Platform (global.json), but Rider and
      Visual Studio discover tests through this adapter unless their own Testing Platform support is switched on.
    -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- TestContext and ITestOutputHelper for JobTracker.TestSupport, without the in-process runner. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- The assertion library every test uses; see docs/conventions/test-antipatterns.md §4. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- The mocking library; see docs/conventions/test-antipatterns.md §3.3 for mock versus fake. -->
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <!-- Hosts JobTracker.Api in memory for its tests. Its version follows the SDK in global.json. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!--
      The architecture rules. The xUnitV3 package supplies .Check(), which reports a violation as a
      test failure listing the offending types rather than as a bare false.
    -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.5" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <!--
      The architecture project's git helper. CsWin32 generates the Win32 job-object P/Invokes that keep a git command
      from outliving its test; xRetry.v3 retries the one git test exposed to a rare OS-level race (see GitTests).
    -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <PackageVersion Include="xRetry.v3" Version="1.0.0" />
  </ItemGroup>
</Project>
