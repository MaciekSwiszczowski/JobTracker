<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JobTracker.UI.ViewModels"
        xmlns:c="using:JobTracker.Contracts"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="JobTracker.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700"
        Title="Job Tracker">

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" CornerRadius="4" Background="#33E53935"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Width="300" PlaceholderText="Search company or title" Text="{Binding SearchText}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <Grid ColumnDefinitions="2*,Auto,3*">
            <ListBox Grid.Column="0" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="c:ApplicationSummary">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Company}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Opacity="0.7">
                                <TextBlock Text="{Binding Status}" />
                                <TextBlock Text="{Binding AppliedOn, StringFormat='Applied {0:yyyy-MM-dd}'}" />
                                <TextBlock Text="{Binding LastEventAt, StringFormat='Last update {0:yyyy-MM-dd}'}"
                                           IsVisible="{Binding LastEventAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" />

            <!-- The ViewLocator turns ApplicationDetailViewModel into ApplicationDetailView. -->
            <ContentControl Grid.Column="2" Margin="12,0,0,0" Content="{Binding Detail}" />
        </Grid>
    </DockPanel>
</Window>
