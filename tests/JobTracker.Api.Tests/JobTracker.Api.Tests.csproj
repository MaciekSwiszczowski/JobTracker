<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>JobTracker.Api.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The service over HTTP, in memory: WebApplicationFactory hosts it without opening a port. Once the endpoints
    reach MongoDB these tests need Docker too, and MongoDbFixture moves to JobTracker.TestSupport (it will have two
    consumers; docs/conventions/test-antipatterns.md §3.1).
  -->

  <ItemGroup>
    <ProjectReference Include="..\JobTracker.TestSupport\JobTracker.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\JobTracker.Api\JobTracker.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Assertion library for every test here; see docs/conventions/test-antipatterns.md §4. -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
