<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>JobTracker.UI.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    View model, formatting and HTTP client tests. They need no window, no display and no running service: view
    models are plain C#, and the client is tested against a stub message handler.
  -->

  <ItemGroup>
    <ProjectReference Include="..\JobTracker.TestSupport\JobTracker.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\JobTracker.UI\JobTracker.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Assertion library for every test here; see docs/conventions/test-antipatterns.md §4. -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
