<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <RootNamespace>JobTracker.Infrastructure.MongoDb.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Integration tests: run against a real MongoDB that Testcontainers starts in Docker. Docker must be running. -->

  <ItemGroup>
    <ProjectReference Include="..\JobTracker.TestSupport\JobTracker.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\JobTracker.Infrastructure.MongoDb\JobTracker.Infrastructure.MongoDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <!-- Assertion library for every test here; see docs/conventions/test-antipatterns.md §4. -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.MongoDb" />
  </ItemGroup>

</Project>
